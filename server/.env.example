# ============================================================
# woodcut-server 환경변수 예시
# ------------------------------------------------------------
# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채우세요.
#   cp .env.example .env
# 비밀번호/키는 절대 Git에 커밋하지 마세요 (.env 는 .gitignore 권장).
# ============================================================

# ---- 서버 ----
PORT=3000
# 프론트엔드 도메인. 여러 개면 쉼표로. file:// 테스트는 비워두면 * 허용.
CORS_ORIGIN=

# ---- MS-SQL (연결 정보는 비공개 운영 문서 참조) ----
MSSQL_HOST=YOUR_DB_HOST
MSSQL_PORT=1433
MSSQL_DATABASE=irin
MSSQL_USERNAME=YOUR_DB_USERNAME
MSSQL_PASSWORD=여기에_비밀번호_입력
# 연결 암호화/인증서 검증 (self-signed 환경에선 no 권장)
MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ---- Google Gemini ----
GEMINI_API_KEY=여기에_GEMINI_API_KEY_입력
GEMINI_MODEL=gemini-2.5-flash

# ---- 솔라피 (문자/알림톡) ----
# 콘솔: https://solapi.com
SOLAPI_API_KEY=여기에_API_KEY
SOLAPI_API_SECRET=여기에_API_SECRET
SOLAPI_SENDER=031-541-4959
# 알림톡 설정 (보유 시에만)
SOLAPI_KAKAO_SENDER_KEY=
SOLAPI_KAKAO_PF_ID=
SOLAPI_KAKAO_TEMPLATE_CODE=
